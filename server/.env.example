# --- HTTP ---
PORT=3000

# --- Postgres ---
DATABASE_URL=postgres://vision:vision@localhost:5432/vision_master

# --- Auth / tokens ---
# Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TTL=3600
REFRESH_TTL=2592000
OTP_TTL=120
OTP_MAX_ATTEMPTS=5
OTP_RATE_WINDOW=60

# --- Kavenegar SMS ---
KAVENEGAR_API_KEY=your-kavenegar-api-key
KAVENEGAR_TEMPLATE=visionmaster-otp
# Optional: only used by the plain send fallback when no template is set.
KAVENEGAR_SENDER=

# --- Content ---
# Directory that mirrors the project layout and holds manifest.json.
MEDIA_ROOT=./media

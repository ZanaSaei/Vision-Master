; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vision Master"
run/main_scene="uid://csjykfgswhgaf"
config/auto_accept_quit=false
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps="60"
config/icon="res://icon.svg"

[audio]

general/text_to_speech=true

[autoload]

Global="*uid://b3q8f06t1vj73"
TransitionManager="*uid://b3bmr0hvx2x7n"
MenuBackground="*uid://xuhqxtyibmvw"
Sfx="*res://autoload/Sfx.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor]

naming/scene_name_casing=1
naming/script_name_casing=2

[gui]

theme/custom_font="res://assets/fonts/Vazirmatn-Regular.ttf"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[gd_scene format=3 uid="uid://bxjasubv8s5aw"]

[ext_resource type="Texture2D" uid="uid://bmgjy6yti5sut" path="res://images/Back.png" id="2_01g4x"]
[ext_resource type="StyleBox" uid="uid://bjh6phxjxpytp" path="res://scenes/shared/HeaderBar.tres" id="2_mqgpj"]

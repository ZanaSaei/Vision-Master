[sub_resource type="GDScript" id="GDScript_xa6db"]
script/source = "extends \"res://autoload/BackButtonHandler.gd\"

# ============================================================
# GRAMMAR SCENE — three swipeable pages via PageView
# Page 1 \"Book\"     → textbook explanation + book exercises
# Page 2 \"Master\"   → deep explanations, mistakes, Persian tips
# Page 3 \"Practice\" → extra drills
# ============================================================

const SCENE_LESSON_MENU := \"res://scenes/lesson_menu/LessonMenu.tscn\"

const FONT_REGULAR_PATH := \"res://assets/fonts/PlusJakartaSans-Regular.ttf\"
const FONT_BOLD_PATH    := \"res://assets/fonts/PlusJakartaSans-Bold.ttf\"
const FONT_ITALIC_PATH  := \"res://assets/fonts/PlusJakartaSans-Italic.ttf\"
const FONT_VAZIRMATN    := \"res://assets/fonts/Vazirmatn-Regular.ttf\"

# ---------- Dark theme ----------
const APP_BG := Color(\"#0b1229\")
const PANEL_BG := Color(\"#0f1b3d\")
const PANEL_BORDER := Color(\"#2d3a6a\")

const TEXT_LIGHT := Color(\"#F1F5F9\")
const TEXT_SOFT := Color(\"#CBD5E1\")
const TEXT_MUTED := Color(\"#94A3B8\")

const SUCCESS := Color(\"#34D399\")
const ERROR := Color(\"#F87171\")
const WARNING := Color(\"#FBBF24\")

# Hard floor for every font size in the Grammar pages — nothing renders
# smaller than this, no matter how long the text or how tight the layout.
const MIN_FONT := 28

var font_regular: FontFile
var font_bold: FontFile
var font_italic: FontFile
var font_farsi: FontFile

# ---------- Per-topic theme ----------
const GRAMMAR_THEMES := {
	\"Future Tense (will)\": {
		\"accent\": Color(\"#2563EB\"),
		\"icon\": \"🔮\"
	},
	\"Adjectives (Comparative & Superlative)\": {
		\"accent\": Color(\"#0891B2\"),
		\"icon\": \"⚖️\"
	},
	\"Past Progressive\": {
		\"accent\": Color(\"#7C3AED\"),
		\"icon\": \"⏳\"
	},
	\"Modals (can, may, must, should)\": {
		\"accent\": Color(\"#EA580C\"),
		\"icon\": \"🚦\"
	},
	\"Countable and Uncountable Nouns\": {
		\"accent\": Color(\"#059669\"),
		\"icon\": \"🧮\"
	},
	\"Present Perfect\": {
		\"accent\": Color(\"#DB2777\"),
		\"icon\": \"✅\"
	},
	\"Conditional Type I\": {
		\"accent\": Color(\"#CA8A04\"),
		\"icon\": \"🔀\"
	},
	\"Passive Voice\": {
		\"accent\": Color(\"#0891B2\"),
		\"icon\": \"🔄\"
	},
	\"Relative Clauses\": {
		\"accent\": Color(\"#7C3AED\"),
		\"icon\": \"🔗\"
	},
	\"Passive Voice with Modals\": {
		\"accent\": Color(\"#059669\"),
		\"icon\": \"🔐\"
	},
}

const DEFAULT_THEME := {
	\"accent\": Color(\"#2563EB\"),
	\"icon\": \"📐\"
}

# ---------- Formula chip colors ----------
const ROLE_COLORS := {
	\"subject\": Color(\"#2563EB\"),
	\"aux\": Color(\"#D97706\"),
	\"verb\": Color(\"#16A34A\"),
	\"object\": Color(\"#7C3AED\"),
	\"negative\": Color(\"#DC2626\"),
	\"other\": Color(\"#64748B\"),
}

@onready var back_button: Button = $HeaderBar/HeaderContent/BackButton
@onready var home_button: Button = $HeaderBar/HeaderContent/HomeButton
@onready var translation_toggle: Button = $HeaderBar/HeaderContent/TranslationToggle
@onready var header_title: Label = $HeaderBar/HeaderContent/HeaderTitle
@onready var page_view: PageView = $MarginContainer/MainLayout/PageView

var _theme: Dictionary = DEFAULT_THEME
var _page_reveals: Dictionary = {}
var _page_revealed: Dictionary = {}

# Whether the Persian translations of English example sentences are shown.
# Off by default (translations hidden). Only the structured \"ترجمه:\" lines and
# table translation cells are affected — pure Persian paragraphs/headings stay.
var _translation_visible: bool = false


func _ready() -> void:
	font_regular = load(FONT_REGULAR_PATH)
	font_bold = load(FONT_BOLD_PATH)
	font_italic = load(FONT_ITALIC_PATH)
	font_farsi = load(FONT_VAZIRMATN)

	if font_bold:
		header_title.add_theme_font_override(\"font\", font_bold)

	# Keep header readable on dark theme.
	header_title.add_theme_color_override(\"font_color\", TEXT_LIGHT)

	back_button.pressed.connect(_on_back_button_pressed)
	home_button.pressed.connect(_on_home_pressed)
	page_view.page_changed.connect(_on_page_changed)

	# Translation toggle: hidden by default. Uses the Farsi font so the label
	# renders correctly, and starts in the \"off\" (muted) state.
	translation_toggle.toggled.connect(_on_translation_toggled)
	if font_farsi:
		translation_toggle.add_theme_font_override(\"font\", font_farsi)
	translation_toggle.add_theme_color_override(\"font_color\", TEXT_MUTED)
	translation_toggle.button_pressed = false

	header_title.text = \"Lesson %d\\nGrammar\" % Global.current_lesson

	# Put a dark background behind the whole PageView.
	_add_page_view_background()

	# Every book (Vision 1/2/3) uses the block-based V{book}_Grammar_All_Lessons.json
	# with three pages: گرامر ساده / گرامر پیشرفته / امتحان. Each lesson renders
	# its own content (selected by Global.current_lesson).
	if Global.current_book in [1, 2, 3]:
		_build_vision1_pages()
		return

	var data: Dictionary = Global.load_category(
		\"grammar\",
		Global.current_book,
		Global.current_lesson
	)

	if data.is_empty():
		return

	var topic_name := str(data.get(\"grammar_topic\", {}).get(\"en\", \"\")).strip_edges()
	_theme = GRAMMAR_THEMES.get(topic_name, DEFAULT_THEME)

	page_view.set_accent(_theme.get(\"accent\", Color(\"#2563EB\")))

	# ---- Build the three pages ----
	page_view.add_page(\"book\", \"Book\", \"📖\", _build_book_page(data))
	page_view.add_page(\"master\", \"Master\", \"🎓\", _build_master_page(data))
	page_view.add_page(\"practice\", \"Practice\", \"💪\", _build_practice_page(data))

	# Force dark backgrounds for PageView scroll areas.
	_apply_dark_scroll_background(page_view)

	_play_reveal(0)


# ============================================================
# VISION 1 — block-based pages (V1_Grammar_All_Lessons.json)
# Three pages: گرامر ساده / گرامر پیشرفته / امتحان
# Each lesson (1-4) renders only its own content, selected by
# Global.current_lesson.
# ============================================================

const V1_EXERCISE_TYPES := [
	\"multiple_choice\", \"true_false\", \"matching\", \"fill_blank\",
	\"open_ended\", \"transformation\", \"error_correction\",
]

var _bold_re := RegEx.new()

# Exam aggregation state
var _exam_engines: Array = []
var _exam_correct := 0
var _exam_total := 0
var _exam_graded_count := 0


func _grammar_path() -> String:
	return \"res://data/V%d_Grammar_All_Lessons.json\" % Global.current_book


func _build_vision1_pages() -> void:
	_bold_re.compile(\"\\\\*\\\\*(.+?)\\\\*\\\\*\")

	var path := _grammar_path()
	var file := FileAccess.open(path, FileAccess.READ)
	if file == null:
		push_error(\"Grammar JSON not found at \" + path)
		return
	var json := JSON.new()
	if json.parse(file.get_as_text()) != OK:
		push_error(\"Grammar JSON parse error at \" + path)
		return
	var root: Dictionary = json.data
	var lessons: Array = root.get(\"lessons\", [])
	if lessons.is_empty():
		push_error(\"Grammar JSON has no lessons at \" + path)
		return

	var idx := clampi(Global.current_lesson - 1, 0, lessons.size() - 1)
	var lesson: Dictionary = lessons[idx]

	var accent := _parse_color(str(lesson.get(\"accent\", \"#2563EB\")))
	_theme = {
		\"accent\": accent,
		\"icon\": str(lesson.get(\"icon\", \"📐\")),
	}
	page_view.set_accent(accent)

	var topic := str(lesson.get(\"topic\", \"\"))
	header_title.text = \"Lesson %d  ·  Grammar\" % Global.current_lesson
	header_title.tooltip_text = topic

	page_view.add_page(\"simple\",   \"گرامر ساده\",    \"📖\", _build_vision1_simple_page(lesson, accent))
	page_view.add_page(\"advanced\", \"گرامر پیشرفته\", \"🎓\", _build_vision1_advanced_page(lesson, accent))
	page_view.add_page(\"exam\",     \"امتحان\",        \"🏆\", _build_vision1_exam_page(lesson, accent))

	_apply_dark_scroll_background(page_view)
	_play_reveal(0)


func _parse_color(hex: String) -> Color:
	if hex.begins_with(\"#\") and hex.length() == 7:
		return Color(hex)
	return Color(\"#2563EB\")


func _new_page() -> VBoxContainer:
	var page := VBoxContainer.new()
	page.add_theme_constant_override(\"separation\", 20)
	return page


func _add_page_spacer(page: VBoxContainer) -> void:
	var spacer := Control.new()
	spacer.custom_minimum_size = Vector2(0, 120)
	spacer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	page.add_child(spacer)


func _build_vision1_simple_page(lesson: Dictionary, accent: Color) -> VBoxContainer:
	var page := _new_page()
	_page_reveals[0] = []

	var banner := _make_vision_banner(\"📖\", \"گرامر ساده\", str(lesson.get(\"topic\", \"\")), accent)
	page.add_child(banner)
	_page_reveals[0].append(banner)

	for block in lesson.get(\"simple_blocks\", []):
		var c := _render_vision1_block(block, page, accent, false)
		if c != null:
			page.add_child(c)
			_page_reveals[0].append(c)

	_add_page_spacer(page)
	return page


func _build_vision1_advanced_page(lesson: Dictionary, accent: Color) -> VBoxContainer:
	var page := _new_page()
	_page_reveals[1] = []

	var banner := _make_vision_banner(\"🎓\", \"گرامر پیشرفته\", \"Master the details\", accent)
	page.add_child(banner)
	_page_reveals[1].append(banner)

	for block in lesson.get(\"master_blocks\", []):
		var c := _render_vision1_block(block, page, accent, false)
		if c != null:
			page.add_child(c)
			_page_reveals[1].append(c)

	_add_page_spacer(page)
	return page


func _build_vision1_exam_page(lesson: Dictionary, accent: Color) -> VBoxContainer:
	var page := _new_page()
	_page_reveals[2] = []
	_exam_engines.clear()
	_exam_correct = 0
	_exam_total = 0
	_exam_graded_count = 0

	var banner := _make_vision_banner(\"🏆\", \"امتحان\", \"Your final exam — score out of 100\", accent)
	page.add_child(banner)
	_page_reveals[2].append(banner)

	var intro := _make_vision_paragraph(
		\"به همهٔ پرسش‌ها پاسخ دهید، سپس دکمهٔ بزرگ «بررسی همهٔ پاسخ‌ها» را در پایین صفحه بزنید تا نمرهٔ خود را از ۱۰۰ ببینید.\",
		accent
	)
	page.add_child(intro)
	_page_reveals[2].append(intro)

	for block in lesson.get(\"exam_exercises\", []):
		var c := _render_vision1_block(block, page, accent, true)
		if c != null:
			page.add_child(c)
			_page_reveals[2].append(c)

	# ---- Single global \"Check All Answers\" button ----
	var check_btn := Button.new()
	check_btn.text = \"بررسی همهٔ پاسخ‌ها  ✓\"
	check_btn.custom_minimum_size = Vector2(0, 96)
	check_btn.add_theme_font_size_override(\"font_size\", 46)
	check_btn.add_theme_color_override(\"font_color\", Color.WHITE)
	if font_bold:
		check_btn.add_theme_font_override(\"font\", font_bold)
	check_btn.pressed.connect(_on_exam_check_all)
	_apply_exam_button_style(check_btn, accent)
	page.add_child(check_btn)
	_page_reveals[2].append(check_btn)

	var hint := Label.new()
	hint.text = \"فقط با یک بار زدن دکمه، همهٔ پاسخ‌ها تصحیح می‌شود.\"
	hint.add_theme_font_size_override(\"font_size\", 32)
	hint.add_theme_color_override(\"font_color\", TEXT_MUTED)
	hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	if font_farsi:
		hint.add_theme_font_override(\"font\", font_farsi)
	page.add_child(hint)
	_page_reveals[2].append(hint)

	_add_page_spacer(page)
	return page


func _render_vision1_block(block: Dictionary, _page: VBoxContainer, accent: Color, hide_footer: bool) -> Control:
	var type := str(block.get(\"type\", \"p\"))
	match type:
		\"h2\":
			return _make_vision_heading(str(block.get(\"text\", \"\")), 46, TEXT_LIGHT)
		\"h3\":
			return _make_vision_heading(str(block.get(\"text\", \"\")), 40, TEXT_LIGHT)
		\"h4\":
			return _make_vision_heading(str(block.get(\"text\", \"\")), 33, TEXT_SOFT)
		\"p\":
			var ptxt := str(block.get(\"text\", \"\"))
			if _is_formula(ptxt):
				return _make_vision_formula(ptxt, accent)
			return _make_vision_paragraph(ptxt, accent)
		\"bullets\":
			return _make_vision_bullets(block.get(\"items\", []), accent)
		\"table\":
			return _make_vision_table(block.get(\"rows\", []), accent)
		\"quote\":
			return _make_vision_quote(block.get(\"lines\", []), accent)
		_:
			if type in V1_EXERCISE_TYPES:
				var engine := ExerciseEngine.new()
				engine.audio_types = [\"multiple_choice\", \"fill_blank\", \"cloze\"]
				engine.audio_panel_scene_path = \"res://scenes/shared/AudioPanel.tscn\"
				engine.hide_footer_buttons = hide_footer
				engine.build(block)
				if hide_footer:
					_exam_engines.append(engine)
					engine.exercise_checked.connect(_on_exam_engine_checked)
				return engine
			return _make_vision_paragraph(str(block.get(\"text\", \"\")), accent)


# ============================================================
# VISION 1 — widgets
# ============================================================

func _has_fa(text: String) -> bool:
	for i in text.length():
		var u: int = text.unicode_at(i)
		if u >= 0x0600 and u <= 0x06FF:
			return true
	return false


# Returns true when Persian characters outnumber Latin ones in `text`.
# Used to pick the base text direction (RTL vs LTR) for lines that mix
# Persian and English, so punctuation and word order stay in the right
# place instead of a single stray Persian word flipping the whole line.
func _is_fa_dominant(text: String) -> bool:
	var fa := 0
	var lat := 0
	for i in text.length():
		var u: int = text.unicode_at(i)
		if u >= 0x0600 and u <= 0x06FF:
			fa += 1
		elif (u >= 0x0041 and u <= 0x007A) or (u >= 0x00C0 and u <= 0x024F):
			lat += 1
	return fa > 0 and fa >= lat


func _to_bbcode(text: String) -> String:
	return _bold_re.sub(text, \"[b]$1[/b]\", true)


func _make_rich_label(text: String, font_size: int, color: Color) -> RichTextLabel:
	font_size += 4
	font_size = maxi(font_size, MIN_FONT)
	var is_fa := _has_fa(text)
	var fa_dominant := _is_fa_dominant(text)
	var rtl := RichTextLabel.new()
	rtl.bbcode_enabled = true
	rtl.fit_content = true
	rtl.scroll_active = false
	rtl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	rtl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	rtl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	rtl.add_theme_font_size_override(\"normal_font_size\", font_size)
	# Keep every text style (bold/italic, used for **highlighted** words) the
	# SAME size as the rest of the paragraph. RichTextLabel uses separate theme
	# items for these; without an override they fall back to the tiny default
	# (16px), which made highlighted words barely visible.
	rtl.add_theme_font_size_override(\"bold_font_size\", font_size)
	rtl.add_theme_font_size_override(\"italics_font_size\", font_size)
	rtl.add_theme_font_size_override(\"bold_italics_font_size\", font_size)
	rtl.add_theme_color_override(\"default_color\", color)
	rtl.text_direction = Control.TEXT_DIRECTION_RTL if fa_dominant else Control.TEXT_DIRECTION_LTR
	if is_fa:
		if font_farsi:
			rtl.add_theme_font_override(\"normal_font\", font_farsi)
			rtl.add_theme_font_override(\"bold_font\", font_farsi)
	else:
		if font_regular:
			rtl.add_theme_font_override(\"normal_font\", font_regular)
		if font_bold:
			rtl.add_theme_font_override(\"bold_font\", font_bold)
	rtl.text = _to_bbcode(text)
	return rtl


func _make_vision_banner(icon: String, fa: String, en: String, accent: Color) -> PanelContainer:
	var banner := PanelContainer.new()
	# Always span the full page width so a short or empty subtitle never
	# collapses the banner (and a long one never stretches it wider than the
	# viewport, which pushed the whole page past the right edge).
	banner.size_flags_horizontal = Control.SIZE_EXPAND_FILL

	var style := StyleBoxFlat.new()
	style.bg_color = _dark_tint(accent, 0.32)
	style.set_corner_radius_all(22)
	style.border_width_left = 6
	style.border_color = accent
	style.set_content_margin_all(28)
	style.shadow_color = Color(accent.r, accent.g, accent.b, 0.35)
	style.shadow_size = 20
	style.shadow_offset = Vector2(0, 8)
	banner.add_theme_stylebox_override(\"panel\", style)

	var v := VBoxContainer.new()
	v.add_theme_constant_override(\"separation\", 12)

	var ic := Label.new()
	ic.text = icon
	ic.add_theme_font_size_override(\"font_size\", 88)
	ic.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v.add_child(ic)

	var title := Label.new()
	title.text = fa
	title.add_theme_font_size_override(\"font_size\", 60)
	title.add_theme_color_override(\"font_color\", TEXT_LIGHT)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	# Wrap + fill so a long title can never widen the banner past the page.
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	if font_farsi:
		title.add_theme_font_override(\"font\", font_farsi)
	v.add_child(title)

	if en != \"\":
		var sub := Label.new()
		sub.text = en
		sub.add_theme_font_size_override(\"font_size\", 34)
		sub.add_theme_color_override(\"font_color\", Color(TEXT_LIGHT.r, TEXT_LIGHT.g, TEXT_LIGHT.b, 0.88))
		sub.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		# The subtitle is the (long, English) lesson topic. Let it wrap and fill
		# the banner width so it can never inflate the page past the viewport.
		sub.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		sub.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		if font_bold:
			sub.add_theme_font_override(\"font\", font_bold)
		v.add_child(sub)

	var bar := ColorRect.new()
	bar.color = accent
	bar.custom_minimum_size = Vector2(0, 6)
	bar.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v.add_child(bar)

	banner.add_child(v)
	return banner


func _make_vision_heading(text: String, font_size: int, color: Color) -> PanelContainer:
	font_size += 4
	# Title pill: boxed, centered. It stretches across the full page width so the
	# label always wraps within the page and never collapses to a thin vertical
	# strip (which happened when a shrink/autowrap label hugged its content).
	var card := PanelContainer.new()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	card.size_flags_vertical = Control.SIZE_SHRINK_BEGIN

	var style := StyleBoxFlat.new()
	style.bg_color = _dark_tint(_theme[\"accent\"], 0.15)
	style.set_corner_radius_all(16)
	style.set_border_width_all(3)
	style.border_color = Color(_theme[\"accent\"].r, _theme[\"accent\"].g, _theme[\"accent\"].b, 0.55)
	style.content_margin_left = 32
	style.content_margin_right = 32
	style.content_margin_top = 10
	style.content_margin_bottom = 10
	card.add_theme_stylebox_override(\"panel\", style)

	var is_fa := _has_fa(text)
	var fa_dominant := _is_fa_dominant(text)
	var lbl := Label.new()
	lbl.text = text
	lbl.add_theme_font_size_override(\"font_size\", maxi(font_size, MIN_FONT))
	lbl.add_theme_color_override(\"font_color\", color)
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	lbl.text_direction = Control.TEXT_DIRECTION_RTL if fa_dominant else Control.TEXT_DIRECTION_LTR
	lbl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	# Wrap long titles so a heading never grows wider than the page.
	lbl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	if is_fa:
		if font_farsi:
			lbl.add_theme_font_override(\"font\", font_farsi)
	else:
		if font_bold:
			lbl.add_theme_font_override(\"font\", font_bold)
	card.add_child(lbl)
	return card


func _is_formula(text: String) -> bool:
	# Grammar structure / formula lines (\"subject + verb\", \"A → B\") are rendered as boxes.
	return \" + \" in text or \"→\" in text


func _make_vision_formula(text: String, accent: Color) -> PanelContainer:
	var card := PanelContainer.new()

	var style := StyleBoxFlat.new()
	style.bg_color = _dark_tint(accent, 0.16)
	style.set_corner_radius_all(14)
	style.border_width_left = 5
	style.border_color = accent.lightened(0.15)
	style.set_content_margin_all(20)
	card.add_theme_stylebox_override(\"panel\", style)

	card.add_child(_make_rich_label(text, 34, TEXT_LIGHT))
	_add_hover_lift(card)
	return card


func _make_vision_paragraph(text: String, _accent: Color) -> Control:
	# Plain paragraph — no box, keeps the page clean.
	var margin := MarginContainer.new()
	margin.add_theme_constant_override(\"margin_left\", 4)
	margin.add_theme_constant_override(\"margin_right\", 4)
	margin.add_theme_constant_override(\"margin_top\", 4)
	margin.add_theme_constant_override(\"margin_bottom\", 4)
	margin.add_child(_make_rich_label(text, 34, TEXT_SOFT))
	return margin


func _make_vision_bullets(items: Array, _accent: Color) -> Control:
	# Clean bullet list — no surrounding box.
	var vbox := VBoxContainer.new()
	vbox.add_theme_constant_override(\"separation\", 10)

	for item in items:
		var row := HBoxContainer.new()
		row.add_theme_constant_override(\"separation\", 12)

		var dot := Label.new()
		dot.text = \"●\"
		dot.add_theme_font_size_override(\"font_size\", maxi(30, MIN_FONT))
		dot.add_theme_color_override(\"font_color\", _theme[\"accent\"])
		dot.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
		dot.mouse_filter = Control.MOUSE_FILTER_IGNORE
		row.add_child(dot)

		if item is Dictionary:
			# Example with an optional Persian translation: {en, fa}.
			var col := VBoxContainer.new()
			col.add_theme_constant_override(\"separation\", 4)
			col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			var en_lbl := _make_rich_label(str(item.get(\"en\", \"\")), 32, TEXT_SOFT)
			en_lbl.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
			col.add_child(en_lbl)
			var fa_text := str(item.get(\"fa\", \"\"))
			if fa_text != \"\":
				var fa_lbl := _make_rich_label(\"ترجمه: \" + fa_text, 29, TEXT_MUTED)
				fa_lbl.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
				# Toggleable Persian translation of this English example.
				fa_lbl.add_to_group(\"grammar_fa_translation\")
				fa_lbl.visible = _translation_visible
				col.add_child(fa_lbl)
			row.add_child(col)
		else:
			var item_lbl := _make_rich_label(str(item), 32, TEXT_SOFT)
			item_lbl.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
			row.add_child(item_lbl)
		vbox.add_child(row)

	return vbox


func _make_vision_table(rows: Array, accent: Color) -> PanelContainer:
	var card := PanelContainer.new()

	var style := StyleBoxFlat.new()
	style.bg_color = Color(\"#0d1630\")
	style.set_corner_radius_all(16)
	style.border_width_left = 4
	style.border_color = accent
	style.set_content_margin_all(14)
	card.add_theme_stylebox_override(\"panel\", style)

	if rows.is_empty():
		return card

	var cols := 0
	for r in rows:
		if (r as Array).size() > cols:
			cols = (r as Array).size()
	if cols <= 0:
		return card

	var grid := GridContainer.new()
	grid.columns = cols
	grid.add_theme_constant_override(\"h_separation\", 12)
	grid.add_theme_constant_override(\"v_separation\", 10)

	for ri in rows.size():
		var row: Array = rows[ri]
		var is_header := ri == 0
		for ci in cols:
			var raw = row[ci] if ci < row.size() else \"\"
			var cell_text: String
			var cell_fa := \"\"
			if raw is Dictionary:
				cell_text = str(raw.get(\"en\", \"\"))
				cell_fa = str(raw.get(\"fa\", \"\"))
			else:
				cell_text = str(raw)
			# Each cell gets its own rounded, bordered panel so cells read as
			# distinct, separated tiles instead of a wall of blended text.
			var cell_style := StyleBoxFlat.new()
			cell_style.set_corner_radius_all(10)
			cell_style.content_margin_left = 12
			cell_style.content_margin_right = 12
			cell_style.content_margin_top = 10
			cell_style.content_margin_bottom = 10
			if is_header:
				cell_style.bg_color = _dark_tint(accent, 0.30)
				cell_style.set_border_width_all(2)
				cell_style.border_color = accent.lightened(0.12)
			else:
				cell_style.bg_color = Color(1, 1, 1, 0.045)
				cell_style.set_border_width_all(1)
				cell_style.border_color = Color(1, 1, 1, 0.09)

			var cell_panel := PanelContainer.new()
			cell_panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			cell_panel.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
			cell_panel.add_theme_stylebox_override(\"panel\", cell_style)

			var cell_wrap := VBoxContainer.new()
			cell_wrap.add_theme_constant_override(\"separation\", 4)
			cell_wrap.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			cell_wrap.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
			var lbl := _make_rich_label(cell_text, 34, TEXT_LIGHT if is_header else TEXT_SOFT)
			lbl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			# Center every cell for a neat, balanced layout.
			lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			if is_header:
				lbl.add_theme_color_override(\"default_color\", accent.lightened(0.15))
			cell_wrap.add_child(lbl)
			if cell_fa != \"\":
				var fa_lbl := _make_rich_label(cell_fa, 29, TEXT_MUTED)
				fa_lbl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
				fa_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
				# Toggleable Persian translation of this English example cell.
				fa_lbl.add_to_group(\"grammar_fa_translation\")
				fa_lbl.visible = _translation_visible
				cell_wrap.add_child(fa_lbl)
			cell_panel.add_child(cell_wrap)
			grid.add_child(cell_panel)

	card.add_child(grid)
	_add_hover_lift(card)
	return card


func _make_vision_quote(lines: Array, accent: Color) -> PanelContainer:
	var card := PanelContainer.new()

	var style := StyleBoxFlat.new()
	style.bg_color = _dark_tint(accent, 0.18)
	style.set_corner_radius_all(16)
	style.border_width_left = 6
	style.border_color = WARNING
	style.set_content_margin_all(20)
	card.add_theme_stylebox_override(\"panel\", style)

	var vbox := VBoxContainer.new()
	vbox.add_theme_constant_override(\"separation\", 8)

	var mark := Label.new()
	mark.text = \"💡\"
	mark.add_theme_font_size_override(\"font_size\", 46)
	mark.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vbox.add_child(mark)

	for line in lines:
		vbox.add_child(_make_rich_label(str(line), 34, TEXT_LIGHT))

	card.add_child(vbox)
	_add_hover_lift(card)
	return card


func _apply_exam_button_style(btn: Button, accent: Color) -> void:
	var style := StyleBoxFlat.new()
	style.bg_color = accent
	style.set_corner_radius_all(18)
	style.set_content_margin_all(22)
	style.shadow_color = Color(accent.r, accent.g, accent.b, 0.45)
	style.shadow_size = 16
	style.shadow_offset = Vector2(0, 6)
	btn.add_theme_stylebox_override(\"normal\", style)

	var hover := style.duplicate() as StyleBoxFlat
	hover.bg_color = accent.lightened(0.15)
	hover.shadow_size = 22
	btn.add_theme_stylebox_override(\"hover\", hover)

	var pressed := style.duplicate() as StyleBoxFlat
	pressed.bg_color = accent.darkened(0.15)
	pressed.shadow_size = 8
	btn.add_theme_stylebox_override(\"pressed\", pressed)


# ============================================================
# VISION 1 — exam grading + score popup
# ============================================================

func _on_exam_check_all() -> void:
	_exam_correct = 0
	_exam_total = 0
	_exam_graded_count = 0
	for engine in _exam_engines:
		engine.call(\"_on_check_pressed\")


func _on_exam_engine_checked(_id: String, correct: int, total: int) -> void:
	_exam_correct += correct
	_exam_total += total
	_exam_graded_count += 1
	if _exam_graded_count >= _exam_engines.size():
		_show_exam_score_popup()


func _show_exam_score_popup() -> void:
	var percent := 0
	if _exam_total > 0:
		percent = int(round(float(_exam_correct) / float(_exam_total) * 100.0))

	# Dim overlay that blocks input behind it.
	var overlay := ColorRect.new()
	overlay.color = Color(0.0, 0.0, 0.0, 0.62)
	overlay.set_anchors_preset(Control.PRESET_FULL_RECT)
	overlay.mouse_filter = Control.MOUSE_FILTER_STOP
	add_child(overlay)

	# Center the card reliably with a CenterContainer.
	var center := CenterContainer.new()
	center.set_anchors_preset(Control.PRESET_FULL_RECT)
	center.mouse_filter = Control.MOUSE_FILTER_IGNORE
	overlay.add_child(center)

	# Center card.
	var card := PanelContainer.new()
	var card_style := StyleBoxFlat.new()
	card_style.bg_color = PANEL_BG
	card_style.set_corner_radius_all(26)
	card_style.border_width_left = 5
	card_style.border_width_right = 5
	card_style.border_color = _theme[\"accent\"]
	card_style.set_content_margin_all(40)
	card_style.shadow_color = Color(0, 0, 0, 0.5)
	card_style.shadow_size = 30
	card.add_theme_stylebox_override(\"panel\", card_style)
	center.add_child(card)
	card.custom_minimum_size = Vector2(520, 0)

	var vbox := VBoxContainer.new()
	vbox.add_theme_constant_override(\"separation\", 16)
	vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL

	var icon := Label.new()
	icon.text = \"🎯\"
	icon.add_theme_font_size_override(\"font_size\", 88)
	icon.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vbox.add_child(icon)

	var title := Label.new()
	title.text = \"نتیجهٔ امتحان\"
	title.add_theme_font_size_override(\"font_size\", 50)
	title.add_theme_color_override(\"font_color\", TEXT_LIGHT)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	if font_farsi:
		title.add_theme_font_override(\"font\", font_farsi)
	vbox.add_child(title)

	var score := Label.new()
	score.text = \"%s / ۱۰۰\" % _to_fa_digits(percent)
	score.add_theme_font_size_override(\"font_size\", 100)
	score.add_theme_color_override(\"font_color\", _theme[\"accent\"].lightened(0.1))
	score.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	if font_bold:
		score.add_theme_font_override(\"font\", font_bold)
	vbox.add_child(score)

	var msg_text := _exam_message(percent)
	var msg := Label.new()
	msg.text = msg_text
	msg.add_theme_font_size_override(\"font_size\", 40)
	msg.add_theme_color_override(\"font_color\", TEXT_SOFT)
	msg.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	msg.autowrap_mode = TextServer.AUTOWRAP_WORD
	if font_farsi:
		msg.add_theme_font_override(\"font\", font_farsi)
	vbox.add_child(msg)

	var detail := Label.new()
	detail.text = \"%s درست از %s پرسش\" % [_to_fa_digits(_exam_correct), _to_fa_digits(_exam_total)]
	detail.add_theme_font_size_override(\"font_size\", 34)
	detail.add_theme_color_override(\"font_color\", TEXT_MUTED)
	detail.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	if font_farsi:
		detail.add_theme_font_override(\"font\", font_farsi)
	vbox.add_child(detail)

	var close_btn := Button.new()
	close_btn.text = \"بستن\"
	close_btn.custom_minimum_size = Vector2(0, 80)
	close_btn.add_theme_font_size_override(\"font_size\", 42)
	close_btn.add_theme_color_override(\"font_color\", Color.WHITE)
	if font_farsi:
		close_btn.add_theme_font_override(\"font\", font_farsi)
	close_btn.pressed.connect(func():
		overlay.queue_free()
	)
	_apply_exam_button_style(close_btn, _theme[\"accent\"])
	vbox.add_child(close_btn)

	card.add_child(vbox)


func _exam_message(percent: int) -> String:
	if percent >= 90:
		return \"عالی! 🎉 تسلط کامل داری.\"
	elif percent >= 75:
		return \"خیلی خوب! فقط کمی تمرین بیشتر.\"
	elif percent >= 50:
		return \"خوب است، ولی می‌توانی بهتر شوی.\"
	elif percent >= 30:
		return \"نیاز به مرور دوباره داری. ادامه بده!\"
	else:
		return \"نگران نباش، دوباره تمرین کن تا بهتر شوی. 💪\"


func _to_fa_digits(num: int) -> String:
	return str(num).replace(\"0\", \"۰\").replace(\"1\", \"۱\").replace(\"2\", \"۲\") \\
		.replace(\"3\", \"۳\").replace(\"4\", \"۴\").replace(\"5\", \"۵\") \\
		.replace(\"6\", \"۶\").replace(\"7\", \"۷\").replace(\"8\", \"۸\").replace(\"9\", \"۹\")


# ============================================================
# DARK THEME HELPERS
# ============================================================

func _add_page_view_background() -> void:
	var bg := ColorRect.new()
	bg.color = APP_BG
	bg.set_anchors_preset(Control.PRESET_FULL_RECT)
	bg.mouse_filter = Control.MOUSE_FILTER_IGNORE

	page_view.add_child(bg)
	page_view.move_child(bg, 0)


func _apply_dark_scroll_background(root: Control) -> void:
	for child in root.get_children():
		if child is ScrollContainer:
			var style := StyleBoxFlat.new()
			style.bg_color = APP_BG
			child.add_theme_stylebox_override(\"panel\", style)

		if child is Control:
			_apply_dark_scroll_background(child)


func _dark_tint(color: Color, amount := 0.16) -> Color:
	# Creates a dark panel color tinted by the given accent color.
	return PANEL_BG.lerp(Color(color.r, color.g, color.b, 1.0), amount)


# ============================================================
# PAGE 1 — BOOK
# ============================================================

func _build_book_page(data: Dictionary) -> VBoxContainer:
	var page := VBoxContainer.new()
	page.add_theme_constant_override(\"separation\", 22)

	var bg: Dictionary = data.get(\"book_grammar\", {})
	_page_reveals[0] = []

	# --- Topic banner ---
	var topic_en: String = data.get(\"grammar_topic\", {}).get(\"en\", \"Grammar\")
	var topic_fa: String = data.get(\"grammar_topic\", {}).get(\"fa\", \"دستور زبان\")
	var banner := _make_topic_banner(str(_theme.get(\"icon\", \"📐\")), topic_en, topic_fa)

	page.add_child(banner)
	_page_reveals[0].append(banner)

	# --- Intro ---
	for intro in bg.get(\"intro\", []):
		var card := _make_text_card(
			intro[\"en\"],
			intro[\"fa\"],
			_dark_tint(_theme[\"accent\"]),
			_theme[\"accent\"]
		)
		page.add_child(card)
		_page_reveals[0].append(card)

	# --- Formula card ---
	if bg.has(\"structure\"):
		page.add_child(_make_section_title(\"Structure\", \"ساختار\"))

		var formula := _make_formula_card(bg[\"structure\"])
		page.add_child(formula)
		_page_reveals[0].append(formula)

	# --- Examples ---
	if not bg.get(\"examples\", []).is_empty():
		page.add_child(_make_section_title(\"Examples\", \"مثال‌ها\"))

		for ex in bg[\"examples\"]:
			var card := _make_text_card(
				ex[\"en\"],
				ex[\"fa\"],
				_dark_tint(_theme[\"accent\"], 0.10),
				_theme[\"accent\"].lightened(0.2)
			)
			page.add_child(card)
			_page_reveals[0].append(card)

	# --- Book exercises ---
	if not bg.get(\"exercises\", []).is_empty():
		page.add_child(_make_section_title(\"Book Exercises\", \"تمرین‌های کتاب\"))

		for exercise in bg[\"exercises\"]:
			var engine := ExerciseEngine.new()
			page.add_child(engine)
			engine.build(exercise)
			_page_reveals[0].append(engine)

	return page


# ============================================================
# PAGE 2 — MASTER
# ============================================================

func _build_master_page(data: Dictionary) -> VBoxContainer:
	var page := VBoxContainer.new()
	page.add_theme_constant_override(\"separation\", 22)

	var mastery: Dictionary = data.get(\"mastery\", {})
	_page_reveals[1] = []

	# --- Page banner ---
	var banner := _make_topic_banner(\"🎓\", \"Master the Grammar\", \"تسلط بر دستور زبان\")
	page.add_child(banner)
	_page_reveals[1].append(banner)

	# --- Explanation sections ---
	for section in mastery.get(\"sections\", []):
		var card := PanelContainer.new()

		var c_style := StyleBoxFlat.new()
		c_style.bg_color = PANEL_BG
		c_style.set_corner_radius_all(16)
		c_style.border_width_left = 5
		c_style.border_color = _theme[\"accent\"]
		c_style.set_content_margin_all(20)

		card.add_theme_stylebox_override(\"panel\", c_style)

		var sv := VBoxContainer.new()
		sv.add_theme_constant_override(\"separation\", 12)

		# Section title: one line, no wrapping.
		sv.add_child(_make_label(section[\"title\"][\"en\"], 40, TEXT_LIGHT, true))
		sv.add_child(_make_fa_label(section[\"title\"][\"fa\"], 32, TEXT_MUTED))

		for point in section.get(\"points\", []):
			sv.add_child(_make_bullet(point[\"en\"], point[\"fa\"]))

		for ex in section.get(\"examples\", []):
			var ex_card := _make_text_card(
				ex[\"en\"],
				ex[\"fa\"],
				_dark_tint(_theme[\"accent\"], 0.10),
				_theme[\"accent\"].lightened(0.2)
			)
			sv.add_child(ex_card)

		card.add_child(sv)
		page.add_child(card)
		_page_reveals[1].append(card)

	# --- Common mistakes ---
	if not mastery.get(\"common_mistakes\", []).is_empty():
		page.add_child(_make_section_title(\"Common Mistakes\", \"\"))

		for mistake in mastery[\"common_mistakes\"]:
			var card := _make_mistake_card(mistake)
			page.add_child(card)
			_page_reveals[1].append(card)

	# --- Persian tips ---
	if not mastery.get(\"tips_fa\", []).is_empty():
		page.add_child(_make_section_title(\"Key Tips\", \"\"))

		for tip in mastery[\"tips_fa\"]:
			var card := _make_insight_card(\"💡 \" + str(tip))
			page.add_child(card)
			_page_reveals[1].append(card)

	# --- See also ---
	if mastery.has(\"see_also\"):
		var see := _make_text_card(
			\"See also: \" + mastery[\"see_also\"][\"en\"],
			\"همچنین ببینید: \" + mastery[\"see_also\"][\"fa\"],
			_dark_tint(WARNING, 0.10),
			WARNING
		)
		page.add_child(see)
		_page_reveals[1].append(see)

	return page


# ============================================================
# PAGE 3 — PRACTICE
# ============================================================

func _build_practice_page(data: Dictionary) -> VBoxContainer:
	var page := VBoxContainer.new()
	page.add_theme_constant_override(\"separation\", 22)

	_page_reveals[2] = []

	# --- Page banner ---
	var banner := _make_topic_banner(\"💪\", \"Extra Practice\", \"تمرین بیشتر\")
	page.add_child(banner)
	_page_reveals[2].append(banner)

	# --- Encouragement intro ---
	var intro := _make_text_card(
		\"The more you practice, the easier grammar becomes. Try these extra exercises!\",
		\"هرچه بیشتر تمرین کنید، دستور زبان آسان‌تر می‌شود. این تمرین‌های اضافی را امتحان کنید!\",
		_dark_tint(SUCCESS, 0.10),
		SUCCESS
	)

	page.add_child(intro)
	_page_reveals[2].append(intro)

	# --- Extra exercises ---
	for exercise in data.get(\"extra_practice\", {}).get(\"exercises\", []):
		var engine := ExerciseEngine.new()
		page.add_child(engine)
		engine.build(exercise)
		_page_reveals[2].append(engine)

	return page


# ============================================================
# WIDGETS
# ============================================================

func _make_topic_banner(icon: String, en: String, fa: String) -> PanelContainer:
	var banner := PanelContainer.new()

	var accent: Color = _theme.get(\"accent\", Color(\"#2563EB\"))

	var b_style := StyleBoxFlat.new()
	b_style.bg_color = accent
	b_style.set_corner_radius_all(20)
	b_style.set_content_margin_all(26)

	banner.add_theme_stylebox_override(\"panel\", b_style)

	var bv := VBoxContainer.new()
	bv.add_theme_constant_override(\"separation\", 8)

	var ic := Label.new()
	ic.text = icon
	ic.add_theme_font_size_override(\"font_size\", 76)
	ic.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	bv.add_child(ic)

	# Choose readable text color based on accent brightness.
	var text_color := Color.WHITE
	if accent.get_luminance() > 0.6:
		text_color = Color(\"#0b1229\")

	var sub_color := Color(text_color.r, text_color.g, text_color.b, 0.85)

	# Banner title: one line, no wrapping.
	var en_label := _make_label(en, 50, text_color, true)
	en_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	bv.add_child(en_label)

	var fa_label := _make_fa_label(fa, 36, sub_color)
	fa_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	bv.add_child(fa_label)

	banner.add_child(bv)
	return banner


func _make_formula_card(structure: Array) -> PanelContainer:
	var card := PanelContainer.new()

	var style := StyleBoxFlat.new()
	style.bg_color = Color(\"#0F172A\")
	style.set_corner_radius_all(18)
	style.border_width_left = 4
	style.border_color = PANEL_BORDER
	style.set_content_margin_all(22)

	card.add_theme_stylebox_override(\"panel\", style)

	var vbox := VBoxContainer.new()
	vbox.add_theme_constant_override(\"separation\", 18)

	for form in structure:
		var row := VBoxContainer.new()
		row.add_theme_constant_override(\"separation\", 8)

		var label_text := str(form[\"label\"][\"en\"]) + \"  ·  \" + str(form[\"label\"][\"fa\"])

		# Formula title: wraps if too long to avoid inflating the page width.
		var lbl := _make_label(label_text, 28, TEXT_MUTED, true)
		lbl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		row.add_child(lbl)

		var chips := HFlowContainer.new()
		chips.add_theme_constant_override(\"separation\", 8)

		for i in form[\"parts\"].size():
			if i > 0:
				var plus := Label.new()
				plus.text = \"+\"
				plus.add_theme_font_size_override(\"font_size\", 34)
				plus.add_theme_color_override(\"font_color\", Color(\"#64748B\"))
				plus.size_flags_vertical = Control.SIZE_SHRINK_CENTER
				plus.mouse_filter = Control.MOUSE_FILTER_IGNORE
				chips.add_child(plus)

			chips.add_child(_make_formula_chip(form[\"parts\"][i]))

		row.add_child(chips)
		vbox.add_child(row)

	card.add_child(vbox)
	return card


func _make_formula_chip(part: Dictionary) -> PanelContainer:
	var chip := PanelContainer.new()

	var color: Color = ROLE_COLORS.get(part.get(\"role\", \"other\"), Color(\"#64748B\"))

	var style := StyleBoxFlat.new()
	style.bg_color = color
	style.set_corner_radius_all(12)
	style.set_content_margin_all(12)

	chip.add_theme_stylebox_override(\"panel\", style)

	var lbl := Label.new()
	lbl.text = str(part.get(\"text\", \"\"))
	lbl.add_theme_font_size_override(\"font_size\", 34)
	lbl.add_theme_color_override(\"font_color\", Color.WHITE)
	lbl.autowrap_mode = TextServer.AUTOWRAP_OFF
	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if font_bold:
		lbl.add_theme_font_override(\"font\", font_bold)

	chip.add_child(lbl)
	return chip


func _make_mistake_card(mistake: Dictionary) -> PanelContainer:
	var card := PanelContainer.new()

	var style := StyleBoxFlat.new()
	style.bg_color = PANEL_BG
	style.set_corner_radius_all(16)
	style.border_width_left = 4
	style.border_color = PANEL_BORDER
	style.set_content_margin_all(18)

	card.add_theme_stylebox_override(\"panel\", style)

	var vbox := VBoxContainer.new()
	vbox.add_theme_constant_override(\"separation\", 10)

	var wrong := Label.new()
	wrong.text = \"✗  \" + str(mistake.get(\"wrong\", \"\"))
	wrong.autowrap_mode = TextServer.AUTOWRAP_WORD
	wrong.add_theme_font_size_override(\"font_size\", 40)
	wrong.add_theme_color_override(\"font_color\", ERROR)
	wrong.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if font_regular:
		wrong.add_theme_font_override(\"font\", font_regular)

	vbox.add_child(wrong)

	var right := Label.new()
	right.text = \"✓  \" + str(mistake.get(\"right\", \"\"))
	right.autowrap_mode = TextServer.AUTOWRAP_WORD
	right.add_theme_font_size_override(\"font_size\", 40)
	right.add_theme_color_override(\"font_color\", SUCCESS)
	right.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if font_bold:
		right.add_theme_font_override(\"font\", font_bold)

	vbox.add_child(right)

	if str(mistake.get(\"note_fa\", \"\")) != \"\":
		vbox.add_child(_make_fa_label(mistake[\"note_fa\"], 30, TEXT_MUTED))

	card.add_child(vbox)
	_add_hover_lift(card)

	return card


func _make_text_card(en: String, fa: String, bg: Color, border: Color) -> PanelContainer:
	var card := PanelContainer.new()

	var style := StyleBoxFlat.new()
	style.bg_color = bg
	style.set_corner_radius_all(14)
	style.border_width_left = 4
	style.border_color = border
	style.set_content_margin_all(18)

	card.add_theme_stylebox_override(\"panel\", style)

	var vbox := VBoxContainer.new()
	vbox.add_theme_constant_override(\"separation\", 6)

	# Body text stays wrapped.
	vbox.add_child(_make_label(en, 36, TEXT_LIGHT, false))
	vbox.add_child(_make_fa_label(fa, 31, TEXT_MUTED))

	card.add_child(vbox)
	_add_hover_lift(card)

	return card


func _make_bullet(en: String, fa: String) -> VBoxContainer:
	var vb := VBoxContainer.new()
	vb.add_theme_constant_override(\"separation\", 4)

	vb.add_child(_make_label(\"•  \" + en, 34, TEXT_SOFT, false))
	vb.add_child(_make_fa_label(fa, 29, TEXT_MUTED))

	return vb


func _make_insight_card(text: String) -> PanelContainer:
	var card := PanelContainer.new()

	var style := StyleBoxFlat.new()
	style.bg_color = PANEL_BG
	style.set_corner_radius_all(14)
	style.border_width_right = 5
	style.border_color = _theme[\"accent\"]
	style.set_content_margin_all(18)

	card.add_theme_stylebox_override(\"panel\", style)

	var lbl := Label.new()
	lbl.text = text
	lbl.autowrap_mode = TextServer.AUTOWRAP_WORD
	lbl.add_theme_font_size_override(\"font_size\", 38)
	lbl.add_theme_color_override(\"font_color\", TEXT_LIGHT)
	lbl.text_direction = Control.TEXT_DIRECTION_RTL
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if font_farsi:
		lbl.add_theme_font_override(\"font\", font_farsi)

	card.add_child(lbl)
	_add_hover_lift(card)

	return card


func _make_section_title(en: String, _fa: String) -> HBoxContainer:
	var row := HBoxContainer.new()
	row.add_theme_constant_override(\"separation\", 14)
	row.size_flags_horizontal = Control.SIZE_EXPAND_FILL

	var bar := ColorRect.new()
	bar.color = _theme[\"accent\"]
	bar.custom_minimum_size = Vector2(6, 44)
	bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	row.add_child(bar)

	# Section title: one line, no wrapping, fills horizontally.
	var title := _make_label(en, 40, TEXT_LIGHT, true)
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(title)

	return row


func _make_label(text: String, font_size: int, color: Color, bold: bool, do_wrap := true) -> Label:
	font_size += 4
	var l := Label.new()
	l.text = text
	l.custom_minimum_size.x = 0
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE

	# Disable wrapping for titles when requested.
	if do_wrap:
		l.autowrap_mode = TextServer.AUTOWRAP_WORD
	else:
		l.autowrap_mode = TextServer.AUTOWRAP_OFF
		l.clip_text = false
		l.text_overrun_behavior = TextServer.OVERRUN_NO_TRIMMING

	# Slightly shrink very long one-line titles so they fit better, but never
	# below MIN_FONT so text always stays readable.
	var final_size := font_size
	if not do_wrap:
		if text.length() > 30:
			final_size = int(float(font_size) * 0.85)
		if text.length() > 55:
			final_size = int(float(font_size) * 0.72)
	final_size = maxi(final_size, MIN_FONT)

	l.add_theme_font_size_override(\"font_size\", final_size)
	l.add_theme_color_override(\"font_color\", color)

	# Mixed Persian/English lines (e.g. formula labels like \"active · معلوم\")
	# pick their base direction and font from whichever script dominates.
	var fa_dominant := _is_fa_dominant(text)
	l.text_direction = Control.TEXT_DIRECTION_RTL if fa_dominant else Control.TEXT_DIRECTION_LTR
	if fa_dominant and font_farsi:
		l.add_theme_font_override(\"font\", font_farsi)
	elif bold and font_bold:
		l.add_theme_font_override(\"font\", font_bold)
	elif not bold and font_regular:
		l.add_theme_font_override(\"font\", font_regular)

	return l


func _make_fa_label(text: String, font_size: int, color: Color, do_wrap := true) -> Label:
	font_size += 4
	var l := Label.new()
	l.text = text
	l.custom_minimum_size.x = 0
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if do_wrap:
		l.autowrap_mode = TextServer.AUTOWRAP_WORD
	else:
		l.autowrap_mode = TextServer.AUTOWRAP_OFF
		l.clip_text = false
		l.text_overrun_behavior = TextServer.OVERRUN_NO_TRIMMING

	# Slightly shrink very long one-line Persian titles, but never below MIN_FONT.
	var final_size := font_size
	if not do_wrap:
		if text.length() > 34:
			final_size = int(float(font_size) * 0.85)
		if text.length() > 60:
			final_size = int(float(font_size) * 0.72)
	final_size = maxi(final_size, MIN_FONT)

	l.add_theme_font_size_override(\"font_size\", final_size)
	l.add_theme_color_override(\"font_color\", color)
	l.text_direction = Control.TEXT_DIRECTION_RTL
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT

	if font_farsi:
		l.add_theme_font_override(\"font\", font_farsi)

	return l


func _add_hover_lift(control: Control) -> void:
	control.mouse_entered.connect(func():
		control.pivot_offset = control.size / 2.0

		var t := create_tween()
		t.tween_property(
			control,
			\"scale\",
			Vector2(1.015, 1.015),
			0.12
		).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	)

	control.mouse_exited.connect(func():
		control.pivot_offset = control.size / 2.0

		var t := create_tween()
		t.tween_property(
			control,
			\"scale\",
			Vector2.ONE,
			0.12
		).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	)


# ============================================================
# ENTRANCE — staggered reveal per page, on first visit
# ============================================================

func _on_page_changed(index: int, _page_id: String) -> void:
	_play_reveal(index)


func _on_translation_toggled(pressed: bool) -> void:
	_translation_visible = pressed
	# Show/hide only the Persian translation lines of English example
	# sentences (the \"ترجمه:\" lines and table translation cells). Pure Persian
	# paragraphs/headings are not part of this group and stay untouched.
	get_tree().call_group(\"grammar_fa_translation\", \"set_visible\", pressed)
	translation_toggle.add_theme_color_override(
		\"font_color\",
		_theme.get(\"accent\", Color(\"#2563EB\")) if pressed else TEXT_MUTED
	)


func _play_reveal(index: int) -> void:
	if _page_revealed.get(index, false):
		return

	_page_revealed[index] = true

	var cards: Array = _page_reveals.get(index, [])

	for i in cards.size():
		var card: Control = cards[i]
		card.modulate.a = 0.0

		var t := create_tween()
		t.tween_property(
			card,
			\"modulate:a\",
			1.0,
			0.3
		).set_delay(0.07 * i).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)


func _on_home_pressed() -> void:
	TransitionManager.change_scene(\"res://scenes/main_menu/MainMenu.tscn\")
func _on_back_button_pressed() -> void:
	back_button.pivot_offset = back_button.size / 2.0

	var t := create_tween()
	t.tween_property(back_button, \"scale\", Vector2(0.96, 0.96), 0.08)

	TransitionManager.change_scene(SCENE_LESSON_MENU)


func _on_android_back_pressed() -> void:
	_on_back_button_pressed()

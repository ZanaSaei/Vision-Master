theme_override_font_sizes/font_size = 30
text = "هر روز یک کلمه‌ی پنهان وجود دارد و حداکثر ۶ تلاش داری تا آن را پیدا کنی. هر ترکیب حروفی به اندازه‌ی کلمه‌ی پنهان، حتی اگر واژه‌ی واقعی نباشد، پذیرفته می‌شود. رنگ‌ها نشان می‌دهند حروف حدس در کجای کلمه‌ی پنهان قرار دارند. کلمه‌ی پنهان هر روز ساعت ۱۲ شب به وقت جهانی (UTC) عوض می‌شود."
horizontal_alignment = 2
autowrap_mode = 2


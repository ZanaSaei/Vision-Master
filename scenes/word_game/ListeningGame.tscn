[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/word_game/listening_game.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/images/ui/Back.png" id="2_back"]
[ext_resource type="StyleBox" path="res://scenes/shared/HeaderBar.tres" id="3_header"]
[ext_resource type="FontFile" path="res://assets/fonts/Vazirmatn-Regular.ttf" id="4_font"]

[sub_resource type="LabelSettings" id="TitleSettings"]
font = ExtResource("4_font")
font_size = 55
font_color = Color(1, 1, 1, 1)

[node name="ListeningGame" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.9372549, 0.9647059, 1, 1)

[node name="HeaderBar" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 0.0
offset_bottom = 200.0
grow_horizontal = 2
theme_override_styles/panel = ExtResource("3_header")

[node name="HeaderContent" type="HBoxContainer" parent="HeaderBar"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 20

[node name="BackButton" type="Button" parent="HeaderBar/HeaderContent"]
layout_mode = 2
icon = ExtResource("2_back")
flat = true

[node name="HeaderTitle" type="Label" parent="HeaderBar/HeaderContent"]
layout_mode = 2
text = "بازی شنیداری"
label_settings = SubResource("TitleSettings")

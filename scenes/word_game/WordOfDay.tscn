[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/word_game/word_of_day.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://images/Back.png" id="2_back"]
[ext_resource type="StyleBox" path="res://scenes/shared/HeaderBar.tres" id="3_header"]

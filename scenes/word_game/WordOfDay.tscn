[ext_resource type="PackedScene" path="res://scenes/word_game/wordle/WordleScreen.tscn" id="5_game"]

[sub_resource type="LabelSettings" id="TitleSettings"]
font = ExtResource("4_font")
font_size = 55
font_color = Color(1, 1, 1, 1)

[node name="WordOfDay" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 34
text = "سلام! من MrSaei هستم، توسعه‌دهنده اپلیکیشن Vision Master. هدف من ساخت ابزارهایی است که یادگیری زبان انگلیسی را برای دانش‌آموزان ایرانی ساده، لذت‌بخش و مؤثر کند. این پروژه با عشق به آموزش و تکنولوژی طراحی و پیاده‌سازی شده است."
horizontal_alignment = 2
autowrap_mode = 3


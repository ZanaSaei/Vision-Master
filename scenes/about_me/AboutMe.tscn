[node name="BioText" type="Label" parent="Scroll/Margin/Layout/BioCard/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.184314, 0.172549, 0.152941, 1)
theme_override_fonts/font = ExtResource("2_font_regular")
theme_override_font_sizes/font_size = 30
theme_override_constants/line_spacing = 10
text = "سلام و درود! من MrSaei هستم، طراح و توسعه‌دهنده اپلیکیشن Vision Master.
ایدهٔ ساخت این برنامه از مشاهده دغدغه‌ها و سردرگمی‌های دانش‌آموزان در یادگیری زبان دبیرستان و آزمون‌های نهایی جرقه خورد. هدف اصلی، خلق یک همراه هوشمند و منسجم بود تا زبان‌آموزان بتوانند بدون نیاز به چندین کتاب مختلف و با روش‌های تعاملی، واژگان، دستور زبان، مهارت شنیداری و مکالمه را عمیق و ماندگار فرا بگیرند. این پروژه با عشق به آموزش و برنامه‌نویسی برای موفقیت شما آماده شده است."
horizontal_alignment = 2
autowrap_mode = 3


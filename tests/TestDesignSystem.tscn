[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://tests/test_design_system.gd" id="1_test"]

; Root MUST be a Control: the theme-owner chain only propagates through
; Control/Window ancestors, so a bare Node root would stop the app-wide Theme
; from reaching the Controls these tests instantiate as children.
[node name="TestDesignSystem" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_test")

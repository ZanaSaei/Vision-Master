class_name TilePreview
extends Control
## ============================================================
##  TILE PREVIEW — visual preview shown while dragging a tile.
##  A lightweight version of ScrambledTile that follows the cursor.
## ============================================================

## Copied from ScrambledTile for visual consistency
const CORNER_RATIO := 0.34
const OUTLINE_RATIO := 0.085
const SIDE_RATIO := 0.16
const LETTER_RATIO := 0.62
const MIN_LETTER_SIZE := 18

var letter := ""
var color_index := 0
var _style := StyleBoxFlat.new()
var _tile_size := 100.0  # Slightly smaller than board tiles


func _ready() -> void:
    mouse_filter = Control.MOUSE_FILTER_IGNORE
    _refresh()


func set_tile_size(px: float) -> void:
    _tile_size = maxf(px * 0.9, 32.0)  # Preview is 90% size
    size = Vector2(_tile_size, _tile_size)
    pivot_offset = size * 0.5
    _refresh()


func _refresh() -> void:
    if size.x <= 0.0:
        return
    var radius := int(maxf(8.0, size.x * CORNER_RATIO))
    _style.set_corner_radius_all(radius)
    _style.set_border_width_all(0)
    _style.bg_color = ScrambledTheme.TILE_OUTLINE
    # Preview floats higher with stronger shadow
    _style.shadow_color = Color(0.10, 0.06, 0.20, 0.35)
    _style.shadow_size = int(round(8.0 + 20.0))
    _style.shadow_offset = Vector2(0.0, 10.0 + 12.0)
    queue_redraw()


func _draw() -> void:
    if size.x <= 0.0 or size.y <= 0.0:
        return
    var body := _body_color()
    var radius := maxf(8.0, size.x * CORNER_RATIO)
    var outline := maxf(2.0, size.x * OUTLINE_RATIO)
    var side := maxf(4.0, size.x * SIDE_RATIO)
    var inner := size - Vector2(outline * 2.0, outline * 2.0)
    if inner.x <= 0.0 or inner.y - side <= 0.0:
        return

    # 1. Dark outline
    draw_style_box(_style, Rect2(Vector2.ZERO, size))
    # 2. Extruded bottom edge
    draw_style_box(_slab_style(ScrambledTheme.tile_side(body), radius),
        Rect2(Vector2(outline, outline), inner))
    # 3. Face
    draw_style_box(_slab_style(body, radius),
        Rect2(Vector2(outline, outline), Vector2(inner.x, inner.y - side)))
    # 4. Gloss
    var gloss_height := maxf(4.0, (inner.y - side) * 0.30)
    draw_style_box(_slab_style(Color(1, 1, 1, 0.25), int(radius * 0.7)),
        Rect2(Vector2(outline + radius * 0.28, outline + radius * 0.20),
            Vector2(inner.x - radius * 0.56, gloss_height)))

    if letter.is_empty():
        return
    var font := MenuStyle.nunito()
    if font == null:
        font = get_theme_default_font()
    var ascent := font.get_ascent(_letter_size)
    var descent := font.get_descent(_letter_size)
    var baseline := (size.y + ascent - descent) * 0.5
    draw_string(font, Vector2(0.0, baseline), letter,
        HORIZONTAL_ALIGNMENT_CENTER, size.x, _letter_size, Color(1, 1, 1, 1))


func _body_color() -> Color:
    return ScrambledTheme.tile_color(color_index)


func _slab_style(color: Color, radius: int) -> StyleBoxFlat:
    var s := StyleBoxFlat.new()
    s.set_corner_radius_all(radius)
    s.bg_color = color
    s.set_border_width_all(0)
    return s


func _letter_size() -> int:
    return maxi(MIN_LETTER_SIZE, int(round(_tile_size * LETTER_RATIO)))
class_name ScrambledConfirmDialog
extends Control
## ============================================================
##  CONFIRM DIALOG — "از بازی خارج می‌شوی؟"
##
##  Leaving mid-session asks first. Quitting is forgiving — the points already
##  earned are written by the session manager — but it still ends the run, so
##  the player gets one deliberate question rather than a back tap that steals
##  their word.
##
##  It is a component scene of its own (per the project's UI rules), and it is
##  laid out with a CenterContainer rather than the fixed offsets the screen
##  used to compute by hand: the card stays centred at any window size, and it
##  is the one screen-sized overlay in this game that opens in both a lesson
##  and the day's competition.
##
##  Nothing is written here. The dialog only reports which answer it was given.
## ============================================================

signal confirmed()
signal cancelled()

## The card is sized by convention (its minimum), not by a magic offset, so a
## longer body text wraps inside the same frame instead of spilling out.
const CARD_MIN_SIZE := Vector2(860, 540)
const BUTTON_MIN_SIZE := Vector2(320, 112)
const OPEN_FADE_TIME := 0.18
## Leaving wears the one danger colour this dialog owns.
const LEAVE_ACCENT := Color("#FF6B6B")

@onready var _card: PanelContainer = $Center/Card
@onready var _title: Label = $Center/Card/Margin/Column/Title
@onready var _body: Label = $Center/Card/Margin/Column/Body
@onready var _stay: Button = $Center/Card/Margin/Column/Choices/Stay
@onready var _leave: Button = $Center/Card/Margin/Column/Choices/Leave


func _ready() -> void:
	visible = false
	_stay.pressed.connect(_on_stay_pressed)
	_leave.pressed.connect(_on_leave_pressed)
	MenuStyle.wire_microinteractions(_stay)
	MenuStyle.wire_microinteractions(_leave)
	apply_theme()


func is_open() -> bool:
	return visible


## Asks the question. `body` differs by mode, because what is at stake does:
## a lesson loses its practice, the day keeps its points.
func open(title: String, body: String) -> void:
	_title.text = title
	_body.text = body
	visible = true
	modulate.a = 0.0
	var tw := create_tween()
	tw.tween_property(self, "modulate:a", 1.0, OPEN_FADE_TIME) \
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	Sfx.click()


func close() -> void:
	visible = false


func apply_theme() -> void:
	_card.add_theme_stylebox_override("panel",
		MenuStyle.card_style(MenuStyle.accent(), 34, true))
	_title.add_theme_font_override("font", MenuStyle.vazir())
	_title.add_theme_font_size_override("font_size", 46)
	_title.add_theme_color_override("font_color", MenuStyle.text())
	_body.add_theme_font_override("font", MenuStyle.vazir())
	_body.add_theme_font_size_override("font_size", 32)
	_body.add_theme_color_override("font_color", MenuStyle.subtitle_color())
	for button in [_stay, _leave]:
		button.add_theme_font_override("font", MenuStyle.vazir())
		button.add_theme_font_size_override("font_size", 36)
	# Staying is the safe answer, so it wears the app accent; leaving wears the
	# one danger colour this dialog owns.
	_leave.add_theme_color_override("font_color", MenuStyle.on_accent(LEAVE_ACCENT))
	for slot in ["normal", "focus"]:
		_leave.add_theme_stylebox_override(slot, ScrambledTheme.candy_button_style(LEAVE_ACCENT, false))
	for slot in ["hover", "pressed"]:
		_leave.add_theme_stylebox_override(slot, ScrambledTheme.candy_button_style(LEAVE_ACCENT, true))


func _on_stay_pressed() -> void:
	close()
	cancelled.emit()


func _on_leave_pressed() -> void:
	confirmed.emit()
